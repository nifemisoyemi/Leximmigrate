# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-generated-secret-key

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Local PostgreSQL. Match the db/user/password you create in setup.
DATABASE_URL=postgres://leximmigrate:changeme@127.0.0.1:5432/leximmigrate

