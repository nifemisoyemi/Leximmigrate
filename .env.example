# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-generated-secret-key

DEBUG=True                          # False in staging/production
ALLOWED_HOSTS=127.0.0.1,localhost   # staging.leximmigrate.com on the server
CSRF_TRUSTED_ORIGINS=               # https://staging.leximmigrate.com on the server

# Local PostgreSQL. Match the db/user/password you create in setup.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/leximmigrate

# Monday information
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

#Stripe information
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Acuity ID
ACUITY_OWNER_ID=40327942

# Postmark information
POSTMARK_SERVER_TOKEN=